# Production environment configuration
# Loaded when running: npm run build && npm run start

# API Configuration
NEXT_PUBLIC_API_URL=https://api.gphusa.com/api/v1
INTERNAL_API_URL=http://10.108.0.2:8000/api/v1
# Internal only: /alan is not served on the public listener (see the API's
