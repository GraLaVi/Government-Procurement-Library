# Development environment configuration
# Loaded when running: npm run dev

# API Configuration
NEXT_PUBLIC_API_URL=http://10.116.0.2:8000/api/v1
INTERNAL_API_URL=http://10.116.0.2:8000/api/v1
QUEUE_TASK_API_URL=http://10.116.0.2:8000/alan/process

# Development flags
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_ENABLE_DEV_SIGNUP=true

# Auth cookies aren't Secure here: this env is also used by `dev.sh demo`
# (next build && next start), which sets NODE_ENV=production, and the app is
# served over plain HTTP at 10.116.0.2 — a Secure cookie would be rejected
# by the browser. See src/lib/auth/cookies.ts.
COOKIE_SECURE=false